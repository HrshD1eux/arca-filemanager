    <string name="about_description">ARCA es un gestor de archivos para Android local y centrado en la privacidad, diseñado con cero telemetría, seguridad de extremo a extremo y alto rendimiento.</string>
    <string name="about_developer">Desarrollador</string>
    <string name="about_source_code">Código fuente</string>
    <string name="about_app_subtitle">Gestor de archivos privado y local</string>
    <string name="about_build_id">ID de compilación: %1$s</string>
