    <string name="about_product_title">Acerca de ARCA</string>
    <string name="about_product_body">ARCA es una utilidad de gestión y compresión de archivos local diseñada para la privacidad, transparencia y rendimiento fiable. Todas las operaciones se ejecutan estrictamente en tu dispositivo sin seguimiento, analítica ni cuentas en la nube.</string>
    <string name="about_updates_disclosure_title">Actualizaciones y uso de Internet</string>
    <string name="about_updates_disclosure_body1">ARCA requiere permiso de Internet únicamente para protocolos de almacenamiento remoto configurados por el usuario y para comprobar lanzamientos oficiales en GitHub. Todas las funciones locales están estrictamente aisladas de la red.</string>
    <string name="about_updates_disclosure_body2">Los paquetes de lanzamiento oficiales, registros de cambios y sumas SHA-256 se publican en GitHub Releases.</string>
    <string name="about_view_github">Ver lanzamientos en GitHub</string>
    <string name="about_privacy_title">Declaración de privacidad</string>
    <string name="about_principle_telemetry_title">Cero telemetría</string>
    <string name="about_principle_telemetry_desc">Sin analítica, SDKs publicitarios, registradores de fallos ni seguimiento.</string>
    <string name="about_principle_accounts_title">Sin necesidad de cuentas</string>
    <string name="about_principle_accounts_desc">Sin registros, perfiles ni cuentas externas en la nube.</string>
    <string name="about_principle_local_title">Ejecución local y red aislada</string>
    <string name="about_principle_local_desc">Tus archivos y claves residen únicamente en tu dispositivo físico.</string>
    <string name="about_principle_network_title">Red exclusivamente iniciada por el usuario</string>
    <string name="about_principle_network_desc">El acceso a la red se utiliza solo para los protocolos remotos que tú configures y comprobación de versiones.</string>
    <string name="about_read_privacy_button">Leer declaración de privacidad detallada</string>
    <string name="about_licenses_title">Licencias de código abierto</string>
    <string name="about_licenses_subtitle">Bibliotecas de terceros y reconocimientos (%1$d)</string>
    <string name="about_licenses_desc">ARCA es de código abierto y se basa en los siguientes proyectos comunitarios:</string>
    <string name="about_developer_title">Desarrollador principal y responsable</string>
    <string name="about_email_button">Correo</string>
