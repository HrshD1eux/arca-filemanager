    <string name="privacy_screen_title">Déclaration de confidentialité</string>
    <string name="privacy_hero_title">Garantie de confidentialité locale et transparente</string>
    <string name="privacy_hero_subtitle">Dernière vérification : %1$s • Zéro télémétrie</string>
    <string name="privacy_hero_body">ARCA repose sur une règle absolue : vos fichiers, dossiers et données personnelles n\'appartiennent qu\'à vous.</string>
    <string name="privacy_section1_title">1. Données traitées localement sur votre appareil</string>
    <string name="privacy_section1_intro">Toutes les opérations d\'ARCA s\'exécutent localement sans aucun traitement cloud :</string>
    <string name="privacy_section1_item1_title">Métadonnées de fichiers et stockage</string>
    <string name="privacy_section1_item1_desc">Les noms et tailles sont lus localement pour afficher les listes, trier et identifier les doublons.</string>
    <string name="privacy_section1_item2_title">Contenu du Coffre privé</string>
    <string name="privacy_section1_item2_desc">Les fichiers du coffre sont chiffrés localement avec AES-256-GCM à partir de votre mot de passe.</string>
    <string name="privacy_section1_item3_title">Préférences et paramètres</string>
    <string name="privacy_section1_item3_desc">Le thème et les options sont stockés dans les SharedPreferences privées de l\'appareil.</string>
    <string name="privacy_section1_item4_title">Identifiants de serveurs distants</string>
    <string name="privacy_section1_item4_desc">Les mots de passe sont conservés uniquement dans le stockage chiffré de l\'application.</string>
    <string name="privacy_section2_title">2. Autorisations demandées et justifications</string>
    <string name="privacy_section2_intro">ARCA ne demande que les autorisations strictement requises :</string>
    <string name="privacy_section2_item1_title">Accès à tous les fichiers (MANAGE_EXTERNAL_STORAGE)</string>
    <string name="privacy_section2_item1_desc">Requis sous Android 11+ pour gérer les fichiers sur le stockage interne et les cartes SD.</string>
    <string name="privacy_section2_item2_title">Stockage hérité (READ/WRITE_EXTERNAL_STORAGE)</string>
    <string name="privacy_section2_item2_desc">Pour les appareils exécutant Android 10 ou antérieur.</string>
    <string name="privacy_section2_item3_title">Notifications (POST_NOTIFICATIONS)</string>
    <string name="privacy_section2_item3_desc">Uniquement pour afficher la progression lors des longues opérations sur les fichiers.</string>
    <string name="privacy_section2_item4_title">Visibilité des applications (QUERY_ALL_PACKAGES)</string>
    <string name="privacy_section2_item4_desc">Utilisé localement pour inspecter les paquets et sauvegarder des fichiers APK.</string>
    <string name="privacy_section2_item5_title">Statistiques d\'utilisation (PACKAGE_USAGE_STATS)</string>
    <string name="privacy_section2_item5_desc">Autorisation optionnelle pour afficher la répartition du stockage des applications.</string>
    <string name="privacy_section2_item6_title">Demandes d\'installation (REQUEST_INSTALL_PACKAGES)</string>
    <string name="privacy_section2_item6_desc">Utilisé uniquement lorsque vous choisissez d\'installer un fichier APK manuellement.</string>
    <string name="privacy_section2_item7_title">Vibrations (VIBRATE)</string>
    <string name="privacy_section2_item7_desc">Pour un retour haptique léger lors des actions.</string>
    <string name="privacy_section2_item8_title">Service de premier plan (DATA_SYNC)</string>
    <string name="privacy_section2_item8_desc">Empêche l\'arrêt prématuré de tâches de compression ou transferts actifs.</string>
    <string name="privacy_section2_item9_title">Maintien de l\'activité (WAKE_LOCK)</string>
    <string name="privacy_section2_item9_desc">Garde le processeur et la connexion Wi-Fi actifs pendant les transferts locaux.</string>
    <string name="privacy_section2_item10_title">Accès Internet (INTERNET)</string>
    <string name="privacy_section2_item10_desc">Permet les connexions réseau manuelles et la vérification des mises à jour sur GitHub.</string>
    <string name="privacy_section2_item11_title">Autorisations expressément exclues</string>
    <string name="privacy_section2_item11_desc">Zéro autorisation de localisation, caméra, microphone ou contacts.</string>
    <string name="privacy_section3_title">3. Fonctionnement des fonctionnalités réseau</string>
    <string name="privacy_section3_intro">ARCA prend en charge les protocoles distants (FTP, FTPS, SFTP, SMB, WebDAV) :</string>
    <string name="privacy_section3_item1_title">Exclusivement initié par l\'utilisateur</string>
    <string name="privacy_section3_item1_desc">ARCA n\'ouvre jamais de connexion réseau de sa propre initiative.</string>
    <string name="privacy_section3_item2_title">Communication directe point à point</string>
    <string name="privacy_section3_item2_desc">Aucun serveur relais intermédiaire ni passerelle cloud.</string>
    <string name="privacy_section3_item3_title">Normes de chiffrement</string>
    <string name="privacy_section3_item3_desc">Prise en charge de SFTP (SSHv2), FTPS (TLS) et HTTPS.</string>
    <string name="privacy_section3_item4_title">ARCA Drop (Partage Wi-Fi local)</string>
    <string name="privacy_section3_item4_desc">Portail web HTTP local protégé par code PIN à 6 chiffres restreint à votre réseau.</string>
    <string name="privacy_section3_item5_title">Vérification des mises à jour</string>
    <string name="privacy_section3_item5_desc">Requête sur l\'API publique de GitHub sans envoyer d\'identifiants d\'appareil.</string>
    <string name="privacy_section3_item6_title">Aucune connexion résiduelle</string>
    <string name="privacy_section3_item6_desc">Les connexions sont fermées dès que l\'opération est terminée.</string>
    <string name="privacy_section4_title">4. Zéro service externe et aucune fuite de données</string>
    <string name="privacy_section4_item1_title">Aucune transmission externe</string>
    <string name="privacy_section4_item1_desc">Aucune donnée n\'est envoyée aux développeurs ou à des régies publicitaires.</string>
    <string name="privacy_section4_item2_title">Aucune publicité ni empreinte</string>
    <string name="privacy_section4_item2_desc">Ne contient aucun SDK de traçage publicitaire.</string>
    <string name="privacy_section4_item3_title">Protection contre les fuites cloud</string>
    <string name="privacy_section4_item3_desc">Le manifeste désactive allowBackup pour protéger vos données locales sensibles.</string>
    <string name="privacy_section5_title">5. Rapports de plantage et analyses</string>
    <string name="privacy_section5_item1_title">Zéro outil d\'analyse</string>
    <string name="privacy_section5_item1_desc">Aucun SDK tel que Google Analytics n\'est inclus.</string>
    <string name="privacy_section5_item2_title">Zéro rapport automatique</string>
    <string name="privacy_section5_item2_desc">Aucun rapport de plantage n\'est envoyé automatiquement sur le réseau.</string>
    <string name="privacy_section5_item3_title">Journaux locaux uniquement</string>
    <string name="privacy_section5_item3_desc">Les erreurs restent enregistrées exclusivement dans le logcat local de votre appareil.</string>
    <string name="privacy_section5_item4_title">Signalement volontaire</string>
    <string name="privacy_section5_item4_desc">Vous gardez le contrôle total sur ce que vous partagez sur GitHub.</string>
    <string name="privacy_section6_title">6. Bibliothèques tierces</string>
    <string name="privacy_section6_intro">Utilisation de bibliothèques open source reconnues et dépourvues de traqueurs.</string>
    <string name="privacy_section7_title">7. Contact et demandes relatives à la confidentialité</string>
