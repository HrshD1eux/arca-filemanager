    <string name="drop_text_snippet_label">সংযুক্ত ব্রাউজারের জন্য টেক্সট স্নsnippet</string>
    <string name="ftp_storage_limited_title">স্টোরেজ অনুমতি সীমিত</string>
    <string name="ftp_storage_limited_desc">কম্পিউটারকে এই ফোন থেকে ফটো, মিডিয়া এবং নথি কপি ও পড়ার অনুমতি দিতে \'সকল ফাইলে অ্যাক্সেস\' অনুমোদন করুন।</string>
    <string name="ftp_grant_button">অনুমতি দিন</string>
    <string name="ftp_recent_activity">সার্ভারের সাম্প্রতিক কার্যকলাপ</string>
    <string name="ftp_select_accessible_folder">অ্যাক্সেসযোগ্য ফোল্ডার বাছুন</string>
    <string name="ftp_share_this_folder">এই ফোল্ডারটি শেয়ার করুন</string>
    <string name="ftp_all_files_required_title">সকল ফাইলে অ্যাক্সেস আবশ্যক</string>
    <string name="ftp_all_files_required_desc">FTP-র মাধ্যমে কম্পিউটারকে এই ফোন থেকে ফাইল ব্রাউজ ও কপি করার অনুমতি দিতে Android-এর \'সকল ফাইলে অ্যাক্সেস\' অনুমতি প্রয়োজন।\n\nএই অনুমতি ছাড়া Android অন্যান্য অ্যাপের ফাইল পড়া আটকে দেয়।</string>
    <string name="ftp_same_network_title">একই নেটওয়ার্কে সংযুক্ত হন</string>
    <string name="ftp_same_network_desc">নিশ্চিত করুন যে এই Android ডিভাইস এবং আপনার PC বা গ্রহণকারী ডিভাইস একই ওয়াই-ফাই বা হটস্পটের সাথে সংযুক্ত।</string>
    <string name="ftp_status_active">সার্ভার সক্রিয় আছে</string>
    <string name="ftp_status_stopped">সার্ভার বন্ধ আছে</string>
    <string name="ftp_network_wifi">ওয়াই-ফাই / হটস্পট</string>
    <string name="ftp_network_none">কোনো নেটওয়ার্ক নেই</string>
    <string name="ftp_connected_clients">সংযুক্ত ক্লায়েন্ট</string>
    <string name="ftp_data_sent">প্রেরিত ডেটা</string>
    <string name="ftp_data_received">গৃহীত ডেটা</string>
    <string name="ftp_intro_card_desc">ইন্টারনেট ছাড়াই স্থানীয় ওয়াই-ফাইয়ের মাধ্যমে এই ফোন এবং কম্পিউটারের (Windows, Mac, Linux) মধ্যে ফাইল, ফটো, ভিডিও ও APK আদান-প্রদান করুন।</string>
